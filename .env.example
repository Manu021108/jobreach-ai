# Application
APP_NAME=JobReach AI
DATABASE_URL=sqlite:///./data/jobreach.db
TIMEZONE=Asia/Kolkata

# Sender profile - edit before generating emails
SENDER_NAME=Manish Kumar Sahu
SENDER_EMAIL=you@gmail.com
SENDER_PHONE=
SENDER_LINKEDIN=
SENDER_GITHUB=
SENDER_LOCATION=Hyderabad, India
PROFILE_SUMMARY=Python Developer and AI/ML Engineer with experience in Python, machine learning, deep learning, Django, FastAPI and Streamlit.
SKILLS=Python, Machine Learning, Deep Learning, Django, FastAPI, Streamlit, SQL
TARGET_ROLES=Python Developer, AI/ML Engineer, Data Engineer

# AI provider: ollama or openai-compatible
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_TEMPERATURE=0.4

# Gmail OAuth - download Desktop OAuth client JSON from Google Cloud Console
GMAIL_CLIENT_SECRET_FILE=credentials/client_secret.json
GMAIL_TOKEN_FILE=credentials/token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.readonly

# Safe sending defaults
DRY_RUN=true
MAX_EMAILS_PER_RUN=5
MIN_SECONDS_BETWEEN_EMAILS=45
MAX_EMAILS_PER_DAY=20
FOLLOWUP_DEFAULT_DAYS=7
