# Application
APP_NAME=JobReach AI
DATABASE_URL=sqlite:///./data/jobreach.db
TIMEZONE=Asia/Kolkata

# Student profile and resume are set during in-app onboarding; no .env editing needed.

# AI provider: ollama or openai-compatible
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_TEMPERATURE=0.4

# Gmail OAuth - download a Web application OAuth client JSON from Google Cloud Console
# Add the redirect URI below to the client's "Authorized redirect URIs" list.
GMAIL_CLIENT_SECRET_FILE=credentials/client_secret.json
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.readonly
# Encrypts per-user Gmail tokens in the database. Use AUTH_SECRET_KEY or set a separate long random value.
GMAIL_TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string

# One-time "Unlock" payment (Stripe)
# Use a Stripe Price ID (recommended) or set the amount in the smallest currency unit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_UNLOCK_AMOUNT=29900
STRIPE_UNLOCK_CURRENCY=inr
# CSV/XLSX with company and email columns; relative paths resolve from the project root.
HR_DATABASE_FILE=data/hr_database.csv

# Safe sending defaults
DRY_RUN=true
MAX_EMAILS_PER_RUN=5
MIN_SECONDS_BETWEEN_EMAILS=45
MAX_EMAILS_PER_DAY=20
AUTO_SEND_WORKER_ENABLED=true
AUTO_SEND_POLL_SECONDS=5
AUTO_SEND_MAX_ATTEMPTS=3
AUTO_SEND_RETRY_BACKOFF_SECONDS=300
FOLLOWUP_DEFAULT_DAYS=7
FOLLOWUP_AUTO_DRAFT_ENABLED=true
FOLLOWUP_POLL_SECONDS=60
FOLLOWUP_MAX_PER_RUN=5

# Student authentication - set a long random secret before deployment
AUTH_SECRET_KEY=change-me-to-a-long-random-string
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_DEV_TOKENS=true
VERIFICATION_TOKEN_HOURS=24
RESET_TOKEN_HOURS=1
FRONTEND_URL=http://127.0.0.1:8000

# SMTP for verification and password reset emails - leave SMTP_HOST empty for local dev tokens
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
